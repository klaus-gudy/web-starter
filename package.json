{
  "name": "web-starter",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "docker compose up --build -V",
    "dev:down": "docker compose down",
    "dev:local": "docker compose up --detach --wait db && docker compose run --rm migrate && prisma generate && node --env-file=.env node_modules/next/dist/bin/next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"scripts/**/*.test.mjs\"",
    "db:generate": "docker compose exec web npx prisma generate",
    "db:migrate": "docker compose exec web sh -c \"npx prisma migrate dev && npx prisma generate\"",
    "db:studio": "docker compose up studio",
    "db:status": "docker compose run --rm migrate node_modules/.bin/prisma migrate status",
    "setup": "node scripts/setup/cli.mjs",
    "configure": "node scripts/setup/cli.mjs --reconfigure"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@shadcn/react": "^0.3.1",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.58.0",
    "next": "16.4.2",
    "next-themes": "^0.4.6",
    "pg": "^8.23.1",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.3.0",
    "react-resizable-panels": "^4.14.5",
    "recharts": "^3.8.0",
    "shadcn": "^4.21.5",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "prisma": "7.10.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
