# Copy to .env and fill in values: cp .env.template .env
# .env is git-ignored; this template is committed.

# Runtime. NODE_ENV isn't set here: `next dev` and the dev container use
# development, `next build`/`next start` and the production image production.
PORT=3000
HOSTNAME=0.0.0.0
NEXT_TELEMETRY_DISABLED=1

# Public (exposed to the browser, baked in at build time)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database (Postgres). Inside Docker the containers reach it at db:5432;
# DB_HOST/DB_PORT are for database tools on your machine (DB_PORT is the
# published port).
DB_HOST=localhost
DB_PORT=5432
DB_NAME=web_starter
DB_USER=web_starter
DB_PASSWORD=change-me
DB_SCHEMA=app
DB_POOL_MAX=10
