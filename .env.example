# Documented configuration template. `npm run setup` generates .env from this
# file with your answers; to do it by hand instead: cp .env.example .env
# .env is git-ignored; this template is committed and holds no real credentials.

# Project identity. Docker Compose prefixes containers, the network, the
# database volume and the images with this name, so every project needs its own.
COMPOSE_PROJECT_NAME=my-app

# Runtime. NODE_ENV isn't set here: `next dev` and the dev container use
# development, `next build`/`next start` and the production image production.
# PORT is the host port the app is published on; inside its container the app
# always listens on 3000.
PORT=3000
HOSTNAME=0.0.0.0
NEXT_TELEMETRY_DISABLED=1

# Public (exposed to the browser, baked in at build time)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database (Postgres). Inside Docker the containers reach it at db:5432;
# DB_HOST/DB_PORT are for the app and database tools on your machine (DB_PORT is
# the published host port). Postgres reads DB_NAME, DB_USER and DB_PASSWORD
# only when the database volume is first created.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=my_app
DB_USER=my_app
DB_PASSWORD=change-me
DB_SCHEMA=app
DB_POOL_MAX=10

# Connection URLs derived from the DB_* values above, for tools that want a
# URL (psql, GUI clients). The app and Prisma read the DB_* values, not these.
# DATABASE_URL is for your machine; DOCKER_DATABASE_URL is what containers
# use, and Compose passes it to them as DATABASE_URL. `npm run configure`
# regenerates both; update them if you edit DB_* by hand.
DATABASE_URL=postgresql://my_app:change-me@localhost:5432/my_app?schema=app
DOCKER_DATABASE_URL=postgresql://my_app:change-me@db:5432/my_app?schema=app

# Optional services. STUDIO_PORT is where `docker compose up studio` publishes
# Prisma Studio. Set COMPOSE_PROFILES=tools to start Studio with every
# `docker compose up`.
STUDIO_PORT=5555
COMPOSE_PROFILES=
