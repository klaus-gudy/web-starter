# Copy to .env and fill in values: cp .env.template .env
# .env is git-ignored; this template is committed.

# Runtime
NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0
NEXT_TELEMETRY_DISABLED=1

# Public (exposed to the browser, baked in at build time)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database (Postgres). DB_HOST/DB_PORT are for running the app on your machine;
# inside docker compose the app reaches the db service at db:5432.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=web_starter
DB_USER=web_starter
DB_PASSWORD=change-me
DB_SCHEMA=app
DB_POOL_MAX=10
